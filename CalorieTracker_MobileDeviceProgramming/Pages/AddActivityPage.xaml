<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalorieTracker_MobileDeviceProgramming.AddActivityPage"
             Title="Add Activity">
    <VerticalStackLayout Spacing="15" Padding="20">

        <Label Text="Date:" FontAttributes="Bold" />
        <DatePicker x:Name="ActivityDate" />

        <Label Text="Activity Name:" FontAttributes="Bold" />
        <Entry x:Name="ActivityName" Placeholder="e.g., Running, Swimming, Cycling" />

        <Label Text="Calories Burned:" FontAttributes="Bold" />
        <Entry x:Name="CaloriesEntry" 
               Placeholder="Enter calories burned"
               Keyboard="Numeric" />

        <Label Text="Description (optional):" FontAttributes="Bold" />
        <Editor x:Name="ContentEditor" 
                Placeholder="Write details about your workout..."
                HeightRequest="150" />

        <Button Text="Save Activity"
                Clicked="OnSaveClicked"
                BackgroundColor="Green"
                TextColor="White"/>

    </VerticalStackLayout>
</ContentPage>