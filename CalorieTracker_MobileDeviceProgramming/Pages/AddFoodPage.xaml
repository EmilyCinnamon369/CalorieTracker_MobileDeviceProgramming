<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalorieTracker_MobileDeviceProgramming.AddFoodPage"
             Title="Add Food">
    <VerticalStackLayout Spacing="15" Padding="20">
        <Label Text="Date:" FontAttributes="Bold" />
        <DatePicker x:Name="MealDate"></DatePicker>

        <Label Text="Meal:" FontAttributes="Bold" />
        <Entry x:Name="MealName" Placeholder="Enter Meal Name" />

        <Label Text="Calories:" FontAttributes="Bold" />
        <Entry x:Name="MealCalories" Placeholder="Enter Meal Calories" />

        <Label Text="Description:" FontAttributes="Bold" />
        <Editor x:Name="ContentEditor" 
            Placeholder="Write about ingredients, nutrition facts, etc..."
            HeightRequest="200" />

        <Button Text="Save Entry"
                Clicked="OnSaveClicked"/>
    </VerticalStackLayout>
</ContentPage>