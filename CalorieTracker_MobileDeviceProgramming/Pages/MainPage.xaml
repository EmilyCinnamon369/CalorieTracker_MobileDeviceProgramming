<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalorieTracker_MobileDeviceProgramming.MainPage">
    
    <Grid RowDefinitions="Auto, *">
        <VerticalStackLayout Grid.Row="0">
            <Label Text="Calorie Tracker"/>
            <Grid ColumnDefinitions="*, *">
                <Button Grid.Column="0"
                        Text="Add Food"
                        Clicked="OnAddFoodClicked"/>
                <Button Grid.Column="1"
                        Text="Add Activity"
                        Clicked="OnAddActivityClicked"/>
                
            </Grid>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        x:Name="DaysCollectionView"
                        SelectionMode="Single"
                        SelectionChanged="OnDaySelected">
            <CollectionView.Header>
                <Label Text="Recent Days"/>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame>
                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, *">
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="{Binding Date}"/>
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding Calories}"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            
        </CollectionView>

    </Grid>

</ContentPage>
