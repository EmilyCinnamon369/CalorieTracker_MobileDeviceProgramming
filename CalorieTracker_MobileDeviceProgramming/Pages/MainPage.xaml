<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalorieTracker_MobileDeviceProgramming.MainPage"
             Title="Calorie Tracker">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="20">

            <Label Text="Calorie Tracker" 
                   FontSize="24" 
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="Add Food"
                        Clicked="OnAddFoodClicked"/>
                <Button Grid.Column="1"
                        Text="Add Activity"
                        Clicked="OnAddActivityClicked"/>
            </Grid>

            <Label Text="Recent Meals" 
                   FontSize="18" 
                   FontAttributes="Bold"
                   Margin="0,10,0,5"/>

            <ListView x:Name="MealsListView"
                      HasUnevenRows="True"
                      HeightRequest="300">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <VerticalStackLayout Padding="10" Spacing="5">
                                <Label Text="{Binding MealName}"
                                       FontAttributes="Bold"
                                       FontSize="16"/>
                                <Label Text="{Binding MealDate, StringFormat='{0:MM/dd/yyyy}'}"
                                       FontSize="12"/>
                                <Label Text="{Binding MealCalories, StringFormat='+{0} calories'}"
                                       FontSize="14"
                                       FontAttributes="Bold"/>
                                <Label Text="{Binding MealDescription}"
                                       FontSize="12"
                                       LineBreakMode="WordWrap"/>
                                <BoxView HeightRequest="1" Color="LightGray"/>
                            </VerticalStackLayout>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Label Text="Recent Activities" 
                   FontSize="18" 
                   FontAttributes="Bold"
                   Margin="0,10,0,5"/>

            <ListView x:Name="ActivitiesListView"
                      HasUnevenRows="True"
                      HeightRequest="300">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <VerticalStackLayout Padding="10" Spacing="5">
                                <Label Text="{Binding ActivityName}"
                                       FontAttributes="Bold"
                                       FontSize="16"/>
                                <Label Text="{Binding ActivityDate, StringFormat='{0:MM/dd/yyyy}'}"
                                       FontSize="12"/>
                                <Label Text="{Binding CaloriesBurned, StringFormat='-{0} calories'}"
                                       FontSize="14"
                                       FontAttributes="Bold"/>
                                <Label Text="{Binding ActivityDescription}"
                                       FontSize="12"
                                       LineBreakMode="WordWrap"/>
                                <BoxView HeightRequest="1" Color="LightGray"/>
                            </VerticalStackLayout>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <BoxView HeightRequest="2" Color="DarkGray" Margin="0,10"/>
            <Grid ColumnDefinitions="*, *, *" HorizontalOptions="Center" ColumnSpacing="20">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="Total Calories In" 
                           FontSize="14" 
                           HorizontalOptions="Center"/>
                    <Label x:Name="TotalCaloriesInLabel" 
                           Text="0" 
                           FontSize="20" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Total Calories Out" 
                           FontSize="14" 
                           HorizontalOptions="Center"/>
                    <Label x:Name="TotalCaloriesOutLabel" 
                           Text="0" 
                           FontSize="20" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2">
                    <Label Text="Net Calories" 
                           FontSize="14" 
                           HorizontalOptions="Center"/>
                    <Label x:Name="NetCaloriesLabel" 
                           Text="0" 
                           FontSize="20" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>